  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/dylansavage/Library/Logs/fuel.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dylansavage/Library/Logs/fuel.log</string>
</dict>
</plist>
