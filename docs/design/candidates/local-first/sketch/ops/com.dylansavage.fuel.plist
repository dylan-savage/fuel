<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dylansavage.fuel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/dylansavage/Desktop/Personal-AI/2026-10-28-fuel/scripts/run.sh</string>
  </array>
  <!-- A long-running server, unlike stash's nightly job: start at login, restart on exit. -->
