{
  "name": "fuel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal calorie and macro tracker: a local-first Home Screen PWA synced to SQLite on the Mac mini.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.domain.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.server.json",
    "e2e": "npm run build && playwright test",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "barcode-detector": "^3.2.3",
    "better-sqlite3": "^13.0.3",
    "dexie": "^4.4.7",
    "hono": "^4.13.14",
    "preact": "^11.1.0",
    "zod": "^4.6.7",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
